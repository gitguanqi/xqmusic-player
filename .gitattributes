# 构建产物必须是 LF：esbuild 只吐 LF，如果 checkout 时被 autocrlf 转成 CRLF，
# build:check 会把「换行不同」误判成「产物过期」。
lib/js/xqmusic.min.js      text eol=lf
lib/css/xqmusic.min.css    text eol=lf
.gitattributes             text eol=lf

# 源码保持 LF，避免 Windows / macOS 之间来回切时的整文件 diff
*.js      text eol=lf
*.mjs     text eol=lf
*.css     text eol=lf
*.vue     text eol=lf
*.md      text eol=lf
*.json    text eol=lf
*.html    text eol=lf
*.lrc     text eol=lf

# 二进制素材，别当文本处理
*.jpg     binary
*.png     binary
*.wav     binary
*.svg     text eol=lf
